{
  "$defs": {
    "StudyId": {
      "enum": [
        "retrieval",
        "calibration",
        "workflow-agent"
      ],
      "title": "StudyId",
      "type": "string"
    }
  },
  "$id": "https://elianchyndale.github.io/paper-reproduction-lab/trial-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_cost_usd": {
      "default": 0.0,
      "maximum": 0.0,
      "minimum": 0.0,
      "title": "Api Cost Usd",
      "type": "number"
    },
    "method": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Method",
      "type": "string"
    },
    "metrics": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "type": "number"
        }
      },
      "title": "Metrics",
      "type": "object"
    },
    "result_id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Result Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "const": 42,
      "default": 42,
      "title": "Seed",
      "type": "integer"
    },
    "split": {
      "const": "test",
      "title": "Split",
      "type": "string"
    },
    "study_id": {
      "$ref": "#/$defs/StudyId"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "result_id",
    "study_id",
    "method",
    "split",
    "metrics"
  ],
  "title": "TrialResult",
  "type": "object"
}
